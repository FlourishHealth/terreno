{
  "dependencies": {
    "@terreno/ui": "workspace:*",
    "expo-router": "catalog:",
    "jspdf": "catalog:",
    "lodash": "catalog:",
    "luxon": "catalog:",
    "react-native": "catalog:",
    "react-native-safe-area-context": "catalog:"
  },
  "description": "Admin panel frontend screens for @terreno/api backends",
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@reduxjs/toolkit": "catalog:",
    "@testing-library/react-native": "catalog:",
    "@types/lodash": "catalog:",
    "@types/luxon": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-redux": "catalog:",
    "typescript": "catalog:"
  },
  "files": [
    "LICENSE",
    "dist/**/*",
    "src/**/*",
    ".ai/**/*"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "name": "@terreno/admin-frontend",
  "peerDependencies": {
    "@reduxjs/toolkit": "catalog:",
    "react": "catalog:",
    "react-native-webview": "catalog:",
    "react-redux": "catalog:"
  },
  "peerDependenciesMeta": {
    "react-native-webview": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "compile": "tsc",
    "compile:watch": "tsc -w",
    "dev": "tsc -w",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:unsafefix": "biome check --write --unsafe .",
    "test": "bun test && for f in ./src/isolated/*.isolated.tsx ./src/isolated/*.isolated.ts; do bun test \"$f\" || exit 1; done",
    "test:agent": "for f in ./src/*.test.ts ./src/*.test.tsx ./src/**/*.test.ts ./src/**/*.test.tsx ./src/isolated/*.isolated.tsx ./src/isolated/*.isolated.ts; do if [ -f \"$f\" ]; then AGENT=1 bun test --only-failures \"$f\" || exit 1; fi; done",
    "test:ci": "bun run test",
    "test:coverage": "bun run ../scripts/check-coverage.ts"
  },
  "types": "dist/index.d.ts",
  "version": "57.0.0"
}
