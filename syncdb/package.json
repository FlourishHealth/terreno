{
  "bin": {
    "terreno-syncdb-codegen": "./src/codegen/cli.ts"
  },
  "bugs": {
    "url": "https://github.com/TerrenoLabs/terreno/issues"
  },
  "dependencies": {
    "luxon": "^3.7.2",
    "socket.io-client": "^4.8.1",
    "tinybase": "^9.5.1"
  },
  "description": "Local-first data layer with TinyBase, durable outbox, and delta sync — part of Terreno, the batteries-included TypeScript framework for universal apps.",
  "devDependencies": {
    "@biomejs/biome": "^2.3.6",
    "@testing-library/react-native": "^13.2.0",
    "@types/bun": "^1.4.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.3.0",
    "@types/react": "~19.2.14",
    "expo-sqlite": "~57.0.1",
    "fake-indexeddb": "^6.0.0",
    "react": "19.2.3",
    "react-test-renderer": "19.2.3",
    "socket.io": "^4.8.1",
    "typescript": "~6.0.3"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./codegen": {
      "bun": "./src/codegen/generate.ts",
      "default": "./dist/codegen/generate.js",
      "types": "./dist/codegen/generate.d.ts"
    },
    "./react": {
      "default": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./testing": {
      "default": "./dist/testing/index.js",
      "types": "./dist/testing/index.d.ts"
    }
  },
  "files": [
    "dist/**/*",
    "src/**/*"
  ],
  "homepage": "https://github.com/TerrenoLabs/terreno#readme",
  "keywords": [
    "local-first",
    "tinybase",
    "sync",
    "offline",
    "terreno"
  ],
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "name": "@terreno/syncdb",
  "peerDependencies": {
    "expo-sqlite": "*",
    "react": "19.2.3"
  },
  "peerDependenciesMeta": {
    "expo-sqlite": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/TerrenoLabs/terreno.git"
  },
  "scripts": {
    "build:binary": "bun build --compile src/codegen/cli.ts --outfile dist/terreno-syncdb-codegen",
    "compile": "tsc",
    "compile:watch": "tsc -w",
    "dev": "tsc -w",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:unsafefix": "biome check --write --unsafe .",
    "test": "bun test",
    "test:agent": "AGENT=1 bun test --only-failures",
    "test:ci": "bun test",
    "test:coverage": "bun run ../scripts/check-coverage.ts"
  },
  "types": "dist/index.d.ts",
  "version": "57.6.0"
}
