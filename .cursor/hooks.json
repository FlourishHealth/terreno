{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": ".rulesync/hooks/quality-check.sh cursor",
        "timeout": 300,
        "loop_limit": 1,
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "type": "command",
        "command": "bun run analyze:fast",
        "timeout": 30
      }
    ]
  }
}
