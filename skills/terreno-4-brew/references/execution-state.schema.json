{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terreno.dev/schemas/execution-state.schema.json",
  "title": "Terreno lifecycle execution state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ip",
    "task",
    "stage",
    "attempt",
    "branch",
    "head_sha",
    "pr",
    "supporting_skills",
    "last_result",
    "artifacts",
    "attempted_approaches",
    "next"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "ip": {"type": ["string", "null"]},
    "task": {"type": ["string", "null"]},
    "stage": {"enum": ["grow", "pick", "roast", "brew", "taste"]},
    "attempt": {"type": "integer", "minimum": 1},
    "branch": {"type": ["string", "null"]},
    "head_sha": {"type": ["string", "null"]},
    "pr": {"type": ["string", "null"]},
    "supporting_skills": {"type": "array", "items": {"type": "string"}},
    "last_result": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "stage-result.schema.json"}
      ]
    },
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "attempted_approaches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "attempt", "summary", "outcome", "evidence"],
        "properties": {
          "stage": {"enum": ["grow", "pick", "roast", "brew", "taste"]},
          "attempt": {"type": "integer", "minimum": 1},
          "summary": {"type": "string"},
          "outcome": {"enum": ["PASS", "FAIL", "BLOCKED", "PENDING"]},
          "evidence": {"type": "string"}
        }
      }
    },
    "next": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "reason", "human_required"],
      "properties": {
        "stage": {
          "type": ["string", "null"],
          "enum": ["grow", "pick", "roast", "brew", "taste", null]
        },
        "reason": {"type": "string"},
        "human_required": {"type": "boolean"}
      }
    }
  }
}
