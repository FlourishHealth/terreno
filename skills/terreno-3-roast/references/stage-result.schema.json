{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terreno.dev/schemas/stage-result.schema.json",
  "title": "Terreno lifecycle stage result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "status",
    "ip",
    "task",
    "attempt",
    "branch",
    "head_sha",
    "pr",
    "supporting_skills",
    "completed",
    "checks",
    "artifacts",
    "failures",
    "blockers",
    "decisions_required",
    "recommended_next_stage",
    "recommended_next_action",
    "next_check_after_seconds"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "stage": {"enum": ["grow", "pick", "roast", "brew", "taste"]},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED", "PENDING"]},
    "ip": {"type": ["string", "null"]},
    "task": {"type": ["string", "null"]},
    "attempt": {"type": "integer", "minimum": 1},
    "branch": {"type": ["string", "null"]},
    "head_sha": {"type": ["string", "null"]},
    "pr": {"type": ["string", "null"]},
    "supporting_skills": {"type": "array", "items": {"type": "string"}},
    "completed": {"type": "array", "items": {"type": "string"}},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "evidence"],
        "properties": {
          "name": {"type": "string"},
          "status": {"enum": ["PASS", "FAIL", "BLOCKED", "PENDING"]},
          "evidence": {"type": "string"}
        }
      }
    },
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement", "severity", "expected", "actual", "evidence"],
        "properties": {
          "requirement": {"type": "string"},
          "severity": {"enum": ["blocking", "non_blocking"]},
          "expected": {"type": "string"},
          "actual": {"type": "string"},
          "evidence": {"type": "string"}
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "summary", "evidence"],
        "properties": {
          "kind": {"enum": ["human", "environment", "access", "external"]},
          "summary": {"type": "string"},
          "evidence": {"type": "string"}
        }
      }
    },
    "decisions_required": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "options", "recommended"],
        "properties": {
          "question": {"type": "string"},
          "options": {"type": "array", "items": {"type": "string"}},
          "recommended": {"type": "string"}
        }
      }
    },
    "recommended_next_stage": {
      "type": ["string", "null"],
      "enum": ["grow", "pick", "roast", "brew", "taste", null]
    },
    "recommended_next_action": {"type": "string"},
    "next_check_after_seconds": {"type": ["integer", "null"], "minimum": 1}
  }
}
