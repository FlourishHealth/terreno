{
  "author": "Josh Gachnang",
  "bugs": {
    "url": "https://github.com/TerrenoLabs/terreno/issues"
  },
  "dependencies": {
    "@openfeature/server-sdk": "^1.22.0",
    "@terreno/api": "57.4.0",
    "express": "^5.2.1",
    "lodash": "^4.18.1"
  },
  "description": "Feature flags and A/B testing plugin for @terreno/api — part of Terreno, the batteries-included TypeScript framework for universal apps.",
  "devDependencies": {
    "@biomejs/biome": "^2.3.6",
    "@terreno/test": "57.4.0",
    "@types/bun": "^1.4.0",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.17",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "typescript": "~6.0.3"
  },
  "homepage": "https://github.com/TerrenoLabs/terreno#readme",
  "keywords": [
    "feature-flags",
    "ab-testing",
    "api",
    "express",
    "terreno"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "name": "@terreno/feature-flags",
  "peerDependencies": {
    "mongoose": "^8.0.0 || ^9.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/TerrenoLabs/terreno.git"
  },
  "scripts": {
    "compile": "bun tsc",
    "compile:watch": "bun tsc -w",
    "dev": "bun tsc -w",
    "lint": "biome check ./src",
    "lint:fix": "biome check --write ./src",
    "test": "bun test",
    "test:agent": "AGENT=1 bun test --only-failures",
    "test:ci": "bun test",
    "test:coverage": "bun run ../scripts/check-coverage.ts"
  },
  "types": "dist/index.d.ts",
  "version": "57.6.0"
}
