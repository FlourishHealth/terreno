  "description": "REST API framework for Express/Mongoose (modelRouter, auth, OpenAPI) — part of Terreno, the batteries-included TypeScript framework for universal apps.",
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@terreno/syncdb": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "catalog:",
    "@types/cors": "^2.8.17",
    "@types/cron": "^2.4.3",
    "@types/express": "catalog:",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/lodash": "catalog:",
    "@types/node": "catalog:",
    "@types/on-finished": "^2.3.4",
