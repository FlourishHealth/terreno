  "peerDependencies": {
    "ioredis": "^5.11.0",
    "mongoose": "^8.0.0 || ^9.0.0",
    "passport-local-mongoose": "^9.0.1",
    "zod": "^4.3.6"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "passport-local-mongoose": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/TerrenoLabs/terreno.git"
  },
  "resolutions": {
    "json5": "2.2.3"
  },
  "scripts": {
    "compile": "node ../.github/scripts/compile-workspace-deps.js && bun tsc",
    "compile:watch": "bun tsc -w",
    "dev": "bun tsc -w",
    "docs": "bunx typedoc@0.28.19 --out docs src/index.ts",
    "lint": "biome check ./src",
    "lint:fix": "biome check --write ./src",
    "lint:unsafefix": "biome check --fix --unsafe ./src",
    "load": "bun src/sync/loadHarness.ts",
    "test": "bun test --update-snapshots",
    "test:agent": "AGENT=1 bun test --only-failures",
    "test:cache:clean": "bun ./src/tests/mongoTestSetup.ts clean",
    "test:cache:setup": "bun ./src/tests/mongoTestSetup.ts setup",
    "test:cache:status": "bun ./src/tests/mongoTestSetup.ts status",
    "test:ci": "bun test",
    "test:coverage": "bun run ../scripts/check-coverage.ts",
    "updateSnapshot": "bun test --update-snapshots"
  },
  "types": "dist/index.d.ts",
  "version": "57.6.0"
}
