{
  "openapi": "3.0.0",
  "info": {
    "title": "Terreno Example API",
    "version": "1.0.0"
  },
  "paths": {
    "/todos": {
      "get": {
        "x-terreno-sync": {
          "collection": "todos",
          "scope": "owner"
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Todo"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTodo"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/todos/{id}": {
      "patch": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTodo"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          }
        }
      },
      "delete": {
        "responses": {
          "200": {
            "description": "Deleted"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Todo": {
        "type": "object",
        "required": ["_id", "title", "created", "updated"],
        "properties": {
          "_id": {"type": "string"},
          "title": {"type": "string"},
          "completed": {"type": "boolean"},
          "ownerId": {"type": "string"},
          "created": {"type": "string", "format": "date-time"},
          "updated": {"type": "string", "format": "date-time"}
        }
      },
      "CreateTodo": {
        "type": "object",
        "properties": {
          "_id": {"type": "string"},
          "title": {"type": "string"},
          "completed": {"type": "boolean"},
          "created": {"type": "string", "format": "date-time"}
        },
        "required": ["title"]
      },
      "UpdateTodo": {
        "type": "object",
        "properties": {
          "title": {"type": "string"},
          "completed": {"type": "boolean"}
        }
      }
    }
  }
}
