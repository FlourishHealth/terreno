{
  "version": 1,
  "hooks": {
    "agentStop": [
      {
        "type": "command",
        "bash": "bun run analyze:full",
        "timeoutSec": 120
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "bun run analyze:fast",
        "timeoutSec": 30
      }
    ]
  }
}
