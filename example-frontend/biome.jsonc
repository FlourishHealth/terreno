{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["../biome.jsonc"],
  "files": {
    "includes": [
      "package.json",
      "**/*.ts",
      "**/*.tsx",
      "!!**/node_modules",
      "!!node_modules",
      "!!**/dist",
      "!!dist",
      "!!**/build",
      "!!build",
      "!!**/.expo",
      "!!.expo",
      "!!**/.next",
      "!!.next",
      "!!**/coverage",
      "!!coverage",
      "!!**/generated",
      "!!generated",
      "!!expo-env.d.ts",
      "!!**/.git"
    ]
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noExplicitAny": "error",
        "noImplicitAnyLet": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["store/openApiSdk.ts", "store/commsOpenApiSdk.ts", "store/syncDbSdk.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noBannedTypes": "off"
          },
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ],
  "plugins": ["../biome/plugins/no-barrel-imports.grit"],
  "root": true
}
