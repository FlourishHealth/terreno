    "/gpt/histories/": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "_id",
            "schema": {
              "properties": {
                "$in": {
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
              },
              "type": "object",
            },
          },
          {
            "in": "query",
            "name": "userId",
            "schema": {
              "oneOf": [
                {
                  "description": "The user who owns this conversation history",
                  "type": "schemaobjectid",
                },
                {
                  "properties": {
                    "$in": {
                      "items": {
                        "type": "schemaobjectid",
                      },
                      "type": "array",
                    },
                  },
                  "type": "object",
                },
              ],
            },
          },
          {
            "in": "query",
            "name": "projectId",
            "schema": {
              "oneOf": [
                {
                  "description": "Project this conversation belongs to",
                  "type": "schemaobjectid",
                },
                {
                  "properties": {
                    "$in": {
                      "items": {
                        "type": "schemaobjectid",
                      },
                      "type": "array",
                    },
                  },
                  "type": "object",
                },
              ],
            },
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "number",
            },
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "number",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "properties": {
                          "_id": {
                            "type": "string",
                          },
                          "created": {
                            "description": "When this document was created",
                            "format": "date-time",
                            "type": "string",
                          },
                          "deleted": {
                            "description": "Deleted objects are not returned in any find() or findOne() by default. Add {deleted: true} to find them.",
                            "type": "boolean",
                          },
                          "ownerId": {
                            "type": "any",
                          },
                          "projectId": {
                            "description": "Project this conversation belongs to",
                            "format": "objectid",
                            "type": "string",
                          },
                          "prompts": {
                            "description": "Ordered list of messages in this conversation",
                            "items": {
                              "properties": {
                                "args": {
                                  "description": "Arguments passed to a tool call",
                                },
                                "content": {
                                  "description": "Multipart content attached to this prompt",
                                  "items": {
                                    "properties": {
                                      "filename": {
                                        "description": "Original filename of the attached file",
                                        "type": "string",
                                      },
                                      "mimeType": {
                                        "description": "MIME type of the content part",
                                        "type": "string",
                                      },
                                      "text": {
                                        "description": "Text content of this part",
                                        "type": "string",
                                      },
                                      "type": {
                                        "description": "The kind of content this part represents",
                                        "enum": [
                                          "text",
                                          "image",
                                          "file",
                                        ],
                                        "type": "string",
                                      },
                                      "url": {
                                        "description": "URL pointing to the content resource",
                                        "type": "string",
                                      },
                                    },
                                    "required": [
                                      "type",
                                    ],
                                    "type": "object",
                                  },
                                  "type": "array",
                                },
                                "model": {
                                  "description": "AI model identifier used for this prompt",
                                  "type": "string",
                                },
                                "rating": {
                                  "description": "User feedback rating for this prompt",
                                  "enum": [
                                    "up",
                                    "down",
                                  ],
                                  "type": "string",
                                },
                                "result": {
                                  "description": "Result returned from a tool call",
                                },
                                "text": {
                                  "description": "Text content of the prompt or response",
                                  "type": "string",
                                },
                                "toolCallId": {
                                  "description": "Identifier linking a tool result to its originating call",
                                  "type": "string",
                                },
                                "toolName": {
                                  "description": "Name of the tool that was invoked",
                                  "type": "string",
                                },
                                "type": {
                                  "description": "Role of this message in the conversation",
                                  "enum": [
                                    "user",
                                    "assistant",
                                    "system",
                                    "tool-call",
                                    "tool-result",
                                  ],
                                  "type": "string",
                                },
                              },
                              "required": [
                                "text",
                                "type",
                              ],
                              "type": "object",
                            },
                            "type": "array",
                          },
                          "title": {
                            "description": "Auto-generated title from the first assistant response",
                            "type": "string",
                          },
                          "updated": {
                            "description": "When this document was last updated",
                            "format": "date-time",
                            "type": "string",
                          },
                          "userId": {
                            "description": "The user who owns this conversation history",
                            "format": "objectid",
                            "type": "string",
                          },
                        },
                        "required": [
                          "userId",
                          "_id",
                          "created",
                          "updated",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "limit": {
                      "type": "number",
                    },
                    "more": {
                      "type": "boolean",
                    },
                    "page": {
                      "type": "number",
                    },
                    "total": {
                      "type": "number",
                    },
