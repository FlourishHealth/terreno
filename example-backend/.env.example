PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/terreno-example?replicaSet=rs0
TOKEN_SECRET=dev-token-secret
REFRESH_TOKEN_SECRET=dev-refresh-secret
TOKEN_ISSUER=terreno-example
SESSION_SECRET=dev-session-secret
TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Auth provider: jwt (default) or better-auth
# AUTH_PROVIDER=jwt

# Better Auth (only when AUTH_PROVIDER=better-auth) — see docs/how-to/configure-better-auth.md
# BETTER_AUTH_SECRET=your-better-auth-secret-min-32-chars
# BETTER_AUTH_URL=http://localhost:4000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional — Swagger UI at /swagger
# ENABLE_SWAGGER=true

# Optional — GCS uploads (admin document storage)
# GCS_BUCKET=your-uploads-bucket

# AI Provider - Vertex AI (uses Application Default Credentials)
# GOOGLE_VERTEX_PROJECT=your-gcp-project-id
# GOOGLE_VERTEX_LOCATION=us-central1
# GOOGLE_VERTEX_ALLOWED_MODELS=gemini-2.5-flash,gemini-2.5-pro

# AI Provider - Gemini API (fallback, uses API key)
# GEMINI_API_KEY=your-gemini-api-key
